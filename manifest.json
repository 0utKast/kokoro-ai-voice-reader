{
  "manifest_version": 3,
  "name": "Kokoro AI Voice Reader — WebGPU TTS",
  "version": "1.1.3",
  "description": "Lector de PDFs, libros y textos con voces ultra-naturales Kokoro-82M y WebGPU en local. 100% privado y offline.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Kokoro AI Voice Reader"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "sidePanel",
    "offscreen",
    "storage",
    "activeTab",
    "contextMenus",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.hf.space/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/libs/*",
        "src/voices/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/libs/Readability.js",
        "src/content/content.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Leer texto seleccionado o artículo con Kokoro AI"
    },
    "stop-playback": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Alt+Shift+X"
      },
      "description": "Detener reproducción de audio"
    }
  }
}
