{
  "manifest_version": 3,
  "name": "Kokoro AI Voice Reader — WebGPU TTS",
  "version": "1.0.0",
  "description": "Lector inteligente de páginas web con voces ultra-naturales Kokoro-82M aceleradas por WebGPU. 100% privado y local.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Kokoro AI Voice Reader"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "offscreen",
    "storage",
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://*.hf.space/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/libs/*",
        "src/voices/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Leer texto seleccionado o artículo con Kokoro AI"
    },
    "stop-playback": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Alt+Shift+X"
      },
      "description": "Detener reproducción de audio"
    }
  }
}
